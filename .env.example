# Copy this to .env for local testing, or paste each line into your hosting
# provider's "Environment Variables" panel (e.g. Render → your service →
# Environment) — never commit a real .env file to git.

# Random long string used to sign session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=change-this-to-a-random-64-char-string

# First-run admin account (created automatically the first time the app
# starts, only if no admin exists yet). Log in with these once, then create
# family accounts from the "Family accounts" page. Consider changing
# ADMIN_PASSWORD and redeploying if you ever need to reset it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Admin

# Gmail address + App Password used to send the one-time login codes.
# Create an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be turned on for that Gmail account).
# If left blank, the app will print login codes to the server log instead
# of emailing them — fine for local testing, NOT fine for real use.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Leave unset to use a local SQLite file (data/app.db) — fine for local
# testing, but NOT safe on Render's free tier since its disk resets on every
# redeploy. For real deployment, set this to a free Neon Postgres connection
# string (Neon dashboard → Connection Details → "Connection string"), e.g.:
# DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require
DATABASE_URL=
